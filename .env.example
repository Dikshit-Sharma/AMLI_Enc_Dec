# Firebase (required for library & analytics)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Library access password
VITE_LIBRARY_PASSWORD=

# API Base URL for Cloud Function proxy (bypasses Citrix Firestore block)
# Default: /api/artifacts (same-origin via Firebase Hosting rewrite)
# Override with full URL if using a different deployment:
# VITE_API_BASE_URL=https://us-central1-amli-enc-dec.cloudfunctions.net/artifacts
# VITE_API_BASE_URL=/api/artifacts

# Groq API key (free from https://console.groq.com - no credit card needed)
# Optional - all features work without it using rule-based logic.
# AI enhancements (deep audit, smart answers, insights) activate when set.
VITE_GROQ_API_KEY=
