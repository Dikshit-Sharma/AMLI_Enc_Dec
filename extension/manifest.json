{
  "manifest_version": 3,
  "name": "GitLab LOC Report",
  "version": "1.1.0",
  "description": "Generate GitLab LOC reports by MR or commit. Enter credentials and date range to see added/deleted lines across your projects.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://repo.maxlifeinsurance.com/*",
    "https://*.gitlab.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "firestore_cors_fix",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitLab LOC Report"
  },
  "icons": {
    "128": "icon128.png"
  }
}
